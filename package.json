{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "frontend": "vite",
    "start": "concurrently -n 'backend,frontend' -c  \"red,blue\" \"nodemon  server/app\" \"npm run frontend\"",
    "build": "tsc && vite build",
    "preview": "vite preview 5000 --strictPort",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "stylelint": "npx stylelint \"**/*.scss\"",
    "stylelint:fix": "npx stylelint \"**/*.scss\" --fix",
    "server": "nodemon server/app.js",
    "translate": "node src/locales/generateTranslations.js && node src/locales/checkTranslations.js"
  },
  "lint-staged": {
    "*.{ts, tsx, js}": [
      "eslint"
    ],
    "*.{scss, css}": [
      "stylelint"
    ],
    "*": [
      "prettier --write --ignore-unknown"
    ]
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@babel/preset-typescript": "^7.29.7",
    "@popperjs/core": "^2.11.8",
    "@react-pdf/renderer": "^4.9.0",
    "csv-parser": "^3.2.1",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-compiler-healthcheck": "^1.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.4",
    "react-select": "^5.10.2",
    "recharts": "^3.10.1",
    "vite-plugin-babel": "^1.7.3",
    "vite-plugin-eslint2": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.14.0",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^10.0.1",
    "@reduxjs/toolkit": "^2.15.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.1",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.12.0",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^16.4.0",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "nodemon": "^3.1.14",
    "papaparse": "^5.7.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.1",
    "vite-plugin-checker": "^0.14.5"
  }
}
